<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    x:Class="PopupPage.ReturnResultPopup"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    BackgroundColor="Transparent"
    Margin="0"
    Padding="0"
    x:TypeArguments="system:Boolean">
    <Border  
        StrokeShape="RoundRectangle 10"
        StrokeThickness="3"
        Stroke="Black"
        Padding="5" 
        BackgroundColor="Yellow">
        <VerticalStackLayout Spacing="6">
            <Label Text="This is a very important message! Do you agree?" />
            <Button Clicked="OnYesButtonClicked" Text="Yes" />
            <Button Clicked="OnNoButtonClicked" Text="No" />
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>