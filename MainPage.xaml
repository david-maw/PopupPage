<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PopupPage.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PopupPage"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="local:MainPage"
    BindingContext="{Binding Source={RelativeSource Self}, x:DataType=local:MainPage}">

    <ScrollView>
        <Grid RowDefinitions="*, auto">
            <FlexLayout
                Padding="30,0"
                AlignContent="SpaceAround"
                AlignItems="Start"
                Direction="Column"
                JustifyContent="SpaceBetween"
                Wrap="Wrap">
                <Button Clicked="OnQuestionClicked" Text="Question" />
                <Button Clicked="OnAppSnackBarClicked" Text="App SnackBar" />
                <Button Clicked="OnPaymentsClicked" Text="Payments" />
                <Button Clicked="OnPopupClicked" Text="Pop Up" />
                <Button Clicked="OnReturnResultClicked" Text="Return Result" />
                <Button Clicked="OnSimplePopupClicked" Text="Simple Popup" />
                <Button Clicked="OnStaticSnackBarClicked" Text="Static SnackBar" />
                <Button Clicked="OnTrialClicked" Text="Trial" />
            </FlexLayout>
            <HorizontalStackLayout
                Grid.Row="1"
                HorizontalOptions="End"
                Spacing="5">
                <Label Text="Dark Mode" VerticalOptions="Center" />
                <Switch Margin="0" IsToggled="{Binding Dark}" />
            </HorizontalStackLayout>
        </Grid>
    </ScrollView>

</ContentPage>
